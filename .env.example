# Proměnné prostředí. Žádný .env soubor se necommituje.
#
# 1) Proměnné spravované Vercelem (DATABASE_URL, CRON_SECRET, …) stáhněte do .env.local:
#      vercel env pull .env.local
#    Ručně je nevyplňujte – .env.local má při načítání přednost před .env.
# 2) Zbytek (níže) zkopírujte do .env a doplňte. Na Vercelu je nastavte přes `vercel env add`.

# --- Spravuje Vercel (Neon integrace + vercel env) – jen pro přehled ---
# DATABASE_URL=postgresql://…           # Neon, poolované spojení (aplikace)
# DATABASE_URL_UNPOOLED=postgresql://…  # Neon, přímé spojení (migrace)
# CRON_SECRET=…                         # token pro /api/cron/* (hlavička Authorization: Bearer …)

# Životopis – odkud si aplikace stáhne obsah CV pro hodnocení shody
CV_URL=https://cv-phi-wine.vercel.app/

# Claude API – hodnocení shody nabídky s CV a třídění pošty
ANTHROPIC_API_KEY=

# Gmail API (OAuth2) – vytvoříte v Google Cloud Console
GMAIL_USER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Notifikace do telefonu přes ntfy (https://ntfy.sh) – zvolte si tajný název tématu
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
