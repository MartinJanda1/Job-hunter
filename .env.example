# Zkopírujte jako .env a doplňte hodnoty. Soubor .env se necommituje.

# Databáze (začátek: SQLite soubor, později PostgreSQL)
DATABASE_URL=file:./data/jobs.db

# Životopis – odkud si aplikace stáhne obsah CV pro hodnocení shody
CV_URL=https://cv-phi-wine.vercel.app/

# Claude API – hodnocení shody nabídky s CV a třídění pošty
ANTHROPIC_API_KEY=

# Gmail API (OAuth2) – vytvoříte v Google Cloud Console
GMAIL_USER=martin.janda1@gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Notifikace do telefonu přes ntfy (https://ntfy.sh) – zvolte si tajný název tématu
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=

# Jak často worker hledá nové nabídky (cron výraz)
SEARCH_CRON=0 */2 * * *
MAIL_CRON=*/10 * * * *
