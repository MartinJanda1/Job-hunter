{
  "name": "job-hunter",
  "private": true,
  "version": "0.2.0",
  "description": "Vyhledávač pracovních příležitostí – hledání, filtrování, odpovědi, pošta a notifikace",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate -w packages/core",
    "db:migrate": "npm run db:migrate -w packages/core",
    "db:studio": "npm run db:studio -w packages/core",
    "cron:search": "node --env-file=.env.local scripts/cron.mjs search",
    "mail:dryrun": "tsx --env-file=.env.local scripts/mail-dryrun.ts",
    "filter:dryrun": "tsx --env-file=.env.local scripts/filter-dryrun.ts",
    "dedupe:dryrun": "tsx --env-file=.env.local scripts/dedupe-dryrun.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
